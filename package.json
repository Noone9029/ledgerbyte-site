{
  "name": "ledgerbyte-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:extract": "node scripts/extract-content.mjs",
    "test:content": "node scripts/verify-content.mjs",
    "test:visuals": "node scripts/verify-visuals.mjs",
    "test:aeo": "playwright test --config=playwright.discovery.config.ts tests/aeo.spec.ts",
    "test:seo": "playwright test --config=playwright.discovery.config.ts tests/seo.spec.ts",
    "test:seo:preview": "node scripts/test-preview-seo.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:content && npm run test:visuals && npm run test:e2e",
    "test:analytics": "node --test tests/analytics-privacy.node.test.mjs",
    "test:campaign": "playwright test --config=playwright.campaign.config.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "postcss": "8.5.33",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
